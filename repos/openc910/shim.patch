diff --git a/smart_run/logical/tb/tb_verilator.v b/smart_run/logical/tb/tb_verilator.v
index ab4fee5..c2136bf 100644
--- a/smart_run/logical/tb/tb_verilator.v
+++ b/smart_run/logical/tb/tb_verilator.v
@@ -434,4 +434,32 @@ module top(
   //if(virtual_counter[31:0]> 32'h3000000) $finish;
   //end
   
+  // STEAD: the waveform and a trace for the fail line, each written only
+  // when its plusarg names a file. With the timescale overridden to 1ns/1ns,
+  // $time is the dump's timestamp.
+  //   R <time> <slot> <pc> <iid>      an instruction retired
+  //   B <time> <iid> <src0> <src1>    the branch unit took an instruction;
+  //                                   time is $time-1, where the dump holds
+  //                                   the operands this edge samples
+  `define STEAD_RT  `CPU_TOP.x_ct_top_0.x_ct_core.x_ct_rtu_top.x_ct_rtu_rob.x_ct_rtu_rob_rt
+  `define STEAD_BJU `CPU_TOP.x_ct_top_0.x_ct_core.x_ct_iu_top.x_ct_iu_bju
+  integer stead_fd;
+  reg [8*512-1:0] stead_file;
+  initial begin
+    stead_fd = 0;
+    if ($value$plusargs("dump_file=%s", stead_file)) begin
+      $dumpfile(stead_file);
+      $dumpvars;
+    end
+    if ($value$plusargs("trace_file=%s", stead_file))
+      stead_fd = $fopen(stead_file, "w");
+  end
+  always @(posedge clk) if (stead_fd != 0) begin
+    if (`tb_retire0) $fwrite(stead_fd, "R %0t 0 %h %0d\n", $time, `retire0_pc, `STEAD_RT.retire_inst0_iid);
+    if (`tb_retire1) $fwrite(stead_fd, "R %0t 1 %h %0d\n", $time, `retire1_pc, `STEAD_RT.retire_inst1_iid);
+    if (`tb_retire2) $fwrite(stead_fd, "R %0t 2 %h %0d\n", $time, `retire2_pc, `STEAD_RT.retire_inst2_iid);
+    if (`STEAD_BJU.idu_iu_rf_bju_sel)
+      $fwrite(stead_fd, "B %0t %0d %h %h\n", $time - 1, `STEAD_BJU.idu_iu_rf_pipe2_iid,
+              `STEAD_BJU.idu_iu_rf_pipe2_src0, `STEAD_BJU.idu_iu_rf_pipe2_src1);
+  end
 endmodule
